{
  // Bun 向けの最小設定。Bun は TS を直接実行するためビルドには使わず、
  // エディタの型チェックと `bunx tsc --noEmit` でのみ参照されます。
  // types に "bun" を指定すると、Bun.YAML / Bun.file などの Bun API と、
  // bun-types が内包する Node 互換グローバル（process など）が解決されます。
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  }
}
