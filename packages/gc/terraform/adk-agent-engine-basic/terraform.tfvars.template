# Copy this file to terraform.tfvars only if you want to override defaults:
#   cp terraform.tfvars.template terraform.tfvars
#
# このサンプルは全変数に default があるため、tfvars 無しでも動きます
# （archive を package-agent-engine.sh で生成済みであることが前提）。
# default を上書きしたいときだけ tfvars を作って該当行を有効化します。
# terraform.tfvars は gitignore 対象（*.tfvars）なのでコミットされません。

# Agent Engine 用 source archive のパス（この .tf の場所からの相対パス）。
# default は package-agent-engine.sh の出力先。別の場所に置いた場合のみ設定します。
# source_archive_path = "../../../../apps/adk-helloworld/.build/source.tar.gz"

# 以下はいずれも default あり。変更したい場合のみコメントを外します。
# display_name   = "adk-helloworld"
# description    = "ADK HelloWorld agent on Vertex AI Agent Engine (inline source)."
# region         = "us-central1"
# python_version = "3.13"

# 呼び出しテストで session(child resource)を作った後、destroy が
# 「contains child resources: sessions」で失敗する場合に FORCE へ切り替えます
# (cleanup.md 参照)。DELETE / FORCE / PREVENT / ABANDON。
# deletion_policy = "FORCE"
