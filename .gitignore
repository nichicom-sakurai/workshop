# macOS
.DS_Store

# Dependencies
node_modules/

# Terraform local runtime files
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfvars
*.tfvars.json

# Python local runtime files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Google ADK local session/runtime store (created by adk run / adk web)
.adk/

# AgentCore direct deployment build artifacts
packages/aws/apps/*/.build/
packages/aws/apps/*/dist/
*.zip

# Bun lockfiles: committed once a package gains a dependency (e.g. cloud-run-rest's
# @types/bun) so installs are repeatable; skeleton packages have none, so none to commit.

# mise machine-local overrides
mise.local.toml
.mise.local.toml

# Secrets / machine-specific values (keep *.template, commit those)
*.local
.env
.env.*
!*.template

# Scratch / temporary working files (not for commit)
tmp/

# Agent worktrees (internal tooling artifacts, not for commit)
.claude/worktrees/
