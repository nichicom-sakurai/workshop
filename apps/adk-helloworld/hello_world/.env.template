# Gemini API key 方式（このサンプルの主手順）の設定テンプレート。
#
# 使い方: このファイルを同じディレクトリに `.env` としてコピーし、実際の API key を入れる。
#   cp hello_world/.env.template hello_world/.env
# 実際の `.env` は .gitignore 済みで、commit されるのはこの `*.template` だけです。
# 実 API key は repository に保存しないでください。

# Vertex AI ではなく Gemini API（API key 方式）を使う宣言。
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Google AI Studio (https://aistudio.google.com/apikey) で取得した API key を入れる。
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# --- Vertex AI 方式へ切り替える場合（README 参照） ---
# 上の 2 行を消し、以下のように書き換える（API key は不要。認証は ADC を使う）。
#   GOOGLE_GENAI_USE_VERTEXAI=TRUE
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
